# Committed-safe local dev config. The Prisma CLI auto-loads this file.
# DO NOT put secrets here — this file is tracked and pushed. Real secrets
# (AUTH_SECRET, etc.) live in .env.local, which is gitignored.

# Postgres — dev (docker-compose service `db`, port 5432)
DATABASE_URL="postgresql://app:dev@localhost:5432/app?schema=public"

# Postgres — test (docker-compose service `db-test`, port 5433)
DATABASE_URL_TEST="postgresql://app:test@localhost:5433/app_test?schema=public"
