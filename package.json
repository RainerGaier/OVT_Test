{
  "name": "hackathon-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:up && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:component": "vitest run --project component",
